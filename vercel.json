{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/og.js": {
      "includeFiles": "{src/data/**,api/_og/**,public/logo.svg}",
      "memory": 1024,
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
