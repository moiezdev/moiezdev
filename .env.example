# Copy to .env and fill in. Restart Vite after changing.

# OpenRouter API key (https://openrouter.ai/keys)
# Without this key, BotFolio uses short local fallbacks.
VITE_OPENROUTER_API_KEY=

# Optional — defaults to deepseek/deepseek-chat (Mistral is automatic fallback)
# VITE_OPENROUTER_MODEL=deepseek/deepseek-chat
