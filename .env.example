# Copy to .env and fill in. Restart Vite after changing.

# OpenRouter API key (https://openrouter.ai/keys).
# Server-side only: read by the /api/chat function, never shipped to the browser.
# On Vercel, add it under Project → Settings → Environment Variables.
# Without it, BotFolio answers with short local fallbacks.
OPENROUTER_API_KEY=

# Optional — defaults to deepseek/deepseek-chat (Mistral is the automatic fallback)
# OPENROUTER_MODEL=deepseek/deepseek-chat

# BotFolio voice — Azure AI Speech, free tier (F0: 500,000 characters/month).
# Create a free "Speech" resource at https://portal.azure.com, then copy Key 1
# and its Region. Server-side only: read by the /api/tts function.
# Without these, BotFolio uses each device's built-in voice instead.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional — one multilingual voice for English and Arabic by default
# AZURE_SPEECH_VOICE=en-US-AndrewMultilingualNeural
