# Copy to .env and fill in. Restart Vite after changing.

# OpenRouter API key (https://openrouter.ai/keys)
# Without this key, MoiezBot uses a local keyword fallback so the UI still works.
VITE_OPENROUTER_API_KEY=

# Optional — defaults to a free model
# VITE_OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
